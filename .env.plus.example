# Copy to .env. Uses the official Codex CLI ChatGPT login, no paid API fallback.
ENVIRONMENT=dev
LLM_PROVIDER=codex
LLM_FALLBACK_ORDER=["codex"]
# Linux/macOS: codex. Windows: absolute path to native codex.exe, not codex.ps1.
CODEX_BINARY=codex
CODEX_MODEL=
CODEX_TIMEOUT=180
VECTOR_BACKEND=chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKING=true
API_HOST=127.0.0.1
CORS_ORIGINS=["http://127.0.0.1:8501","http://localhost:8501"]
